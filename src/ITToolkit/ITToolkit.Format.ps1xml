<?xml version="1.0" encoding="utf-8"?>
<!-- Default table views for ITToolkit output. Every property is still on the objects;
     use Select-Object * or Format-List * to see all of them. -->
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>ITToolkit.CheckResult</Name>
      <ViewSelectedBy><TypeName>ITToolkit.CheckResult</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>ComputerName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Check</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Check</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.HealthSummary</Name>
      <ViewSelectedBy><TypeName>ITToolkit.HealthSummary</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Reachable</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Fail</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Warn</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>OK</Label><Width>4</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Issues</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Reachable</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Fail</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Warn</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OK</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Issues</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.PendingReboot</Name>
      <ViewSelectedBy><TypeName>ITToolkit.PendingReboot</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>RebootPending</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>UptimeDays</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Reasons</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RebootPending</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UptimeDays</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Reasons -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.LocalAdmin</Name>
      <ViewSelectedBy><TypeName>ITToolkit.LocalAdmin</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>ComputerName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>Class</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>Note</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Class</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Note</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.Software</Name>
      <ViewSelectedBy><TypeName>ITToolkit.Software</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>ComputerName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>44</Width></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Publisher</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>Installed</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Scope</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Publisher</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.InstallDate) { ([datetime]$_.InstallDate).ToString('yyyy-MM-dd') }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Scope</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.EventGroup</Name>
      <ViewSelectedBy><TypeName>ITToolkit.EventGroup</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>ComputerName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>LastSeen</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Count</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Level</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Summary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.LastSeen) { ([datetime]$_.LastSeen).ToString('yyyy-MM-dd HH:mm') }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Count</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Level</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Note) { $_.Note } else { $_.Message }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.Event</Name>
      <ViewSelectedBy><TypeName>ITToolkit.Event</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>ComputerName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Time</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Level</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.TimeCreated) { ([datetime]$_.TimeCreated).ToString('yyyy-MM-dd HH:mm') }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Level</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.Session</Name>
      <ViewSelectedBy><TypeName>ITToolkit.Session</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>UserName</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Session</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label><Width>3</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Idle</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>LogonTime</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UserName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SessionName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>IdleTime</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.LogonTime -is [datetime]) { $_.LogonTime.ToString('yyyy-MM-dd HH:mm') } else { $_.LogonTime }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.PortTest</Name>
      <ViewSelectedBy><TypeName>ITToolkit.PortTest</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>From</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>ComputerName</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Service</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Open</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Service</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Open</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LatencyMs</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.TempCleanup</Name>
      <ViewSelectedBy><TypeName>ITToolkit.TempCleanup</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label><Width>48</Width></TableColumnHeader>
          <TableColumnHeader><Label>FilesRemoved</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Freed</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>InUse</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>FilesRemoved</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Freed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Failed</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.Setting</Name>
      <ViewSelectedBy><TypeName>ITToolkit.Setting</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Section</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Value</Label><Width>60</Width></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Section</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Value) -join ', '</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.CommandInfo</Name>
      <ViewSelectedBy><TypeName>ITToolkit.CommandInfo</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Synopsis</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Synopsis</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.UserCheck</Name>
      <ViewSelectedBy><TypeName>ITToolkit.UserCheck</TypeName></ViewSelectedBy>
      <GroupBy><PropertyName>UserName</PropertyName></GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Check</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Check</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.Lockout</Name>
      <ViewSelectedBy><TypeName>ITToolkit.Lockout</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Time</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>UserName</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>CallerComputer</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>DomainController</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Note</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap/>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.TimeCreated) { ([datetime]$_.TimeCreated).ToString('yyyy-MM-dd HH:mm') }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>UserName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CallerComputer</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DomainController</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Note</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>ITToolkit.PasswordReset</Name>
      <ViewSelectedBy><TypeName>ITToolkit.PasswordReset</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>UserName</PropertyName></ListItem>
              <ListItem><PropertyName>DisplayName</PropertyName></ListItem>
              <ListItem><PropertyName>Passphrase</PropertyName></ListItem>
              <ListItem><PropertyName>MustChangeAtNextSignIn</PropertyName></ListItem>
              <ListItem><PropertyName>Unlocked</PropertyName></ListItem>
              <ListItem><PropertyName>DomainController</PropertyName></ListItem>
              <ListItem><Label>Problems</Label><ScriptBlock>@($_.Problems) -join '; '</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

  </ViewDefinitions>
</Configuration>
