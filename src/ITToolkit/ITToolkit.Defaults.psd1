# ITToolkit default settings.
#
# Do not edit this file to change settings for your organization: it is
# replaced on every update. Put only the keys you want to change in
#     $env:ProgramData\ITToolkit\Settings.psd1
# using the same layout, for example:
#     @{ Network = @{ InternalDnsNames = @('dc01.corp.example.com') } }
# Get-ITToolkitSetting shows the values in effect and where each came from.
@{
    Health       = @{
        # Warn when the computer has not restarted for this many days.
        UptimeDaysWarn               = 14
        # Free space on every fixed drive, as a percentage of its size.
        DiskFreePercentWarn          = 15
        DiskFreePercentFail          = 8
        # Free space on the Windows drive, in GB (applies to the system drive only).
        DiskFreeGBWarn               = 15
        DiskFreeGBFail               = 5
        # Microsoft Defender signature age, in days.
        DefenderSignatureAgeDaysWarn = 3
        # Days since the newest installed Windows update (hotfix).
        PatchAgeDaysWarn             = 40
        # Days since Windows Update last checked for updates successfully.
        UpdateScanAgeDaysWarn        = 7
    }
    Network      = @{
        # Names every computer should resolve. Add internal names (a domain
        # controller, file server or ITHub) to InternalDnsNames.
        DnsNames             = @('login.microsoftonline.com', 'outlook.office365.com')
        InternalDnsNames     = @()
        # host:port pairs every computer should reach.
        TcpTargets           = @('login.microsoftonline.com:443', 'outlook.office365.com:443', 'graph.microsoft.com:443')
        TimeoutMs            = 3000
        # Warn when a remote computer's clock differs from yours by more than this.
        ClockSkewSecondsWarn = 120
        # Warn when Windows Time has not synced for this many days.
        TimeSyncAgeDaysWarn  = 8
    }
    TempCleanup  = @{
        # Clear-ITTempFile only removes files not changed for this many days.
        OlderThanDays = 7
    }
    EventSummary = @{
        Hours     = 24
        MaxEvents = 500
    }
    Passphrase   = @{
        WordCount = 4
        Separator = '-'
        Digits    = 2
    }
}
